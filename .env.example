# Database Connection (PostgreSQL)
# For production, supply your hosted PostgreSQL connection string (Supabase, Neon, Railway, AWS RDS, etc.)
DATABASE_URL="postgresql://username:password@localhost:5432/letscode_dsa?schema=public"

# NextAuth / Auth.js v5 Configuration
# Generate a secure secret using: npx auth secret or openssl rand -base64 32
AUTH_SECRET="your_production_random_base64_secret_here"
NEXTAUTH_URL="http://localhost:3000"

# Google OAuth Provider (Optional - leave empty if using Credentials / Demo login only)
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Public Application URL (e.g., https://your-deployment-domain.vercel.app or http://localhost:3000)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

